{
  // The short address for label links: a Worker that only redirects to the
  // site (site/short-worker.mjs). Its address must match "shortUrl" in
  // site.json, and SITE_URL must match "url" there. Deployed by
  // `npm run deploy` after the site itself.
  "name": "package-efficiency-short",
  "main": "site/short-worker.mjs",
  "compatibility_date": "2026-09-01",
  "routes": [{ "pattern": "pe.prelude.ltda", "custom_domain": true, "zone_name": "prelude.ltda" }],
  "vars": { "SITE_URL": "https://package-efficiency.prelude.ltda" },
  "workers_dev": false,
  "preview_urls": false
}
