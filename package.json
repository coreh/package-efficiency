{
  "name": "npm-efficiency",
  "private": true,
  "type": "module",
  "scripts": {
    "fetch-top": "node scripts/fetch-top.mjs",
    "prepare-batches": "node scripts/prepare-batches.mjs",
    "merge-categories": "node scripts/merge-categories.mjs",
    "measure": "node scripts/measure.mjs",
    "measure-types": "node scripts/measure-types.mjs",
    "sweep-types:pypi": "node scripts/sweep-types/pypi.mjs",
    "sweep-types:rubygems": "node scripts/sweep-types/rubygems.mjs",
    "sweep-types:cargo": "node scripts/sweep-types/cargo.mjs",
    "build": "node scripts/build-data.mjs && node scripts/build-site.mjs",
    "measure-all": "node scripts/measure-all.mjs",
    "update-popularity": "node scripts/update-popularity.mjs",
    "setup": "node scripts/setup.mjs",
    "setup-apps": "node scripts/setup-apps.mjs",
    "status": "node scripts/status.mjs",
    "clean": "node scripts/clean.mjs",
    "refresh": "node scripts/refresh.mjs",
    "measure-checks": "node scripts/refresh-checks.mjs",
    "test": "node --test harness/tests/*.test.mjs site/tests/*.test.mjs",
    "preview": "node scripts/preview.mjs",
    "deploy": "npm run build && wrangler deploy && wrangler deploy -c wrangler.short.jsonc"
  },
  "devDependencies": {
    "@iconify-json/logos": "1.2.15",
    "highlight.js": "11.12.0",
    "simple-icons": "16.33.0",
    "typescript": "7.0.2",
    "wrangler": "^4.143.1"
  }
}
