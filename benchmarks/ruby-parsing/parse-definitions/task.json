{
  "category": "ruby-parsing",
  "task": "parse-definitions",
  "title": "Ruby file to its definitions",
  "summary": "Parse one Ruby source file of 94 to 380 lines and return the classes, modules and methods it defines, in order, with nesting path, line and parameter names.",
  "kind": "sync-operation",
  "load": {
    "warmup": 2000,
    "rounds": 3,
    "operationsPerRound": 100000,
    "minRoundMs": 250
  },
  "metrics": {
    "cpu": {
      "key": "cpuMs",
      "displayUnit": "µs",
      "headline": "µs of CPU per operation"
    },
    "memory": {
      "key": "memoryBytes",
      "displayUnit": "MB",
      "headline": "MB after GC, above baseline",
      "floor": 4000000
    }
  }
}
