source "https://rubygems.org"

# The gems `hanami new` puts in the Gemfile of a new application with no
# assets and no database (hanami new shop --skip-assets --skip-db), and
# nothing else: its development, test and CLI groups are left out because a
# production install leaves them out.
gem "hanami", "~> 3.0"
gem "hanami-action", "~> 3.0"
gem "hanami-router", "~> 3.0"
gem "hanami-view", "~> 3.0"

gem "dry-types", "~> 1.7"
gem "dry-operation", ">= 1.0.1"
gem "dry-validation", "~> 1.11"
gem "i18n", "~> 1.14"
gem "puma", ">= 7.1"
gem "rake"
