{
  "category": "web-application-frameworks",
  "task": "api-route",
  "title": "API route",
  "summary": "Answer an API route with one item's data as JSON.",
  "kind": "http-server",
  "ecosystems": [
    "npm",
    "pypi",
    "rubygems"
  ],
  "load": {
    "workers": 2,
    "connections": 8,
    "warmup": 2000,
    "rounds": 3,
    "requestsPerRound": 6000
  },
  "metrics": {
    "cpu": {
      "key": "cpuMs",
      "displayUnit": "µs",
      "headline": "µs of CPU per request"
    },
    "memory": {
      "key": "memoryBytes",
      "displayUnit": "MB",
      "headline": "MB after GC, above baseline",
      "floor": 4000000
    }
  }
}
